# Local end-to-end test of the agents against anvil (no testnet ETH needed). Copy to agents/.env
# (agents/.env overrides the root .env and is gitignored). Uses ONLY anvil's well-known dev keys.
#
#   1. anvil --chain-id 421614 --port 8547 --block-time 1
#   2. cd contracts && ARBITER_ADDRESS=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65 \
#        ARBITER_PUBKEY=0x04bf6ee64a8d2fdc551ec8bb9ef862ef6b4bcb1805cdc520c3aa5866c0575fd3b514c5562c3caae7aec5cd6f144b57135c75b6f6cea059c3d08d1f39a9c227219d \
#        QUALITY_WINDOW=15 DELIVER_TIMEOUT=30 ARBITER_TIMEOUT=45 \
#        forge script script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8547 \
#          --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 --broadcast
#      cp broadcast/Deploy.s.sol/421614/run-latest.json broadcast/local-run-latest.json
#      rm -rf broadcast/Deploy.s.sol/421614      # keep the real testnet broadcast dir clean
#   3. cp agents/.env.local.example agents/.env
#   4. SYNC_LOCAL=1 pnpm sync   (add SYNC_SKIP_WEB=1 to leave web/src/lib/generated/contract.ts alone)
#   5. DEMO_EXPIRES_IN=60 DEMO_RESOLVE_IN=90 DEADLINE_MARGIN=3 DEMO_PACE=0 CLASS_C_MIN_LOCK_SECONDS=60 pnpm demo   (~2 min)
#      (CLASS_C_MIN_LOCK_SECONDS must stay below DEMO_RESOLVE_IN or the broker skips the DemandSignal listing)
#   6. rm agents/.env contracts/broadcast/local-run-latest.json; run `pnpm sync` again after the real deploy.
#
# Explorer links print as "(local) <hash>"; multicall3 is skipped automatically for a localhost RPC.
ARBITRUM_SEPOLIA_RPC_URL=http://127.0.0.1:8547
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
SELLER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BUYER_LAB_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
BUYER_BROKER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
ARBITER_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
ARBITER_ADDRESS=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
ARBITER_PUBKEY=0x04bf6ee64a8d2fdc551ec8bb9ef862ef6b4bcb1805cdc520c3aa5866c0575fd3b514c5562c3caae7aec5cd6f144b57135c75b6f6cea059c3d08d1f39a9c227219d
ANTHROPIC_API_KEY=
DEMO_PACE=0
# Optional knobs (all read by the agents):
#   DEMO_EXPIRES_IN / DEMO_RESOLVE_IN  seconds until a listing expires / its bond unlocks (default 180 / 330)
#   DEADLINE_MARGIN                    seconds agents wait past a deadline before acting (default 10)
#   SCOUT_RUN                          force the per-run Scout identity index (default: treasury tx count)
#   UNDERCLOUD_NO_MULTICALL=1          per-id reads instead of multicall3
#   CLASS_C_MIN_LOCK_SECONDS           buyers' minimum bond lock on DemandSignal / ProviderReference (demo default 200; 30 d in production)
